# Copy to .env for `docker compose up`, or export these in your shell for `pnpm dev`.
# Every variable is optional, and an empty value means the default.
# Set values are the code's defaults. Empty ones say what the default is in the comment above them.

# API (apps/api)
# Demo pack the API and the web server read. Empty means data/demo in this checkout.
WELLS_DATA_DIR=
# Level of the API's JSON request logs: DEBUG, INFO, WARNING, ERROR or CRITICAL.
WELLS_LOG_LEVEL=INFO
# Sentry DSN for unhandled API errors. Empty sends nothing.
WELLS_SENTRY_DSN=
# Comma-separated origins allowed to call the API from a browser. Empty allows any origin.
WELLS_CORS_ORIGINS=

# Web server (apps/web, scripts/dev.mjs)
# Where the Next.js server calls the API. The browser uses NEXT_PUBLIC_API_URL instead.
WELLS_API_URL=http://127.0.0.1:8121
# Port for the web app.
WEB_PORT=3000
# Set to 1 to serve the production build instead of `next dev`. `pnpm start` sets it.
WELLS_PROD=

# Browser bundle. docker compose passes the first two as build arguments; see apps/web/.env.example for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8121
# Maps JavaScript and Map Tiles APIs. Without a key the arrival opens on the field and every other screen works.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# The name, tagline and label on screen.
NEXT_PUBLIC_BRAND=N-W-I-S
NEXT_PUBLIC_BRAND_TAGLINE=Offset-well memory
NEXT_PUBLIC_BRAND_LABEL=Oil India Limited

# Demo video (recording/), only for `pnpm film`, `pnpm shots` and `tsx recording/peek.ts`.
WELLS_URL=http://localhost:3000
FILM_FROM=0
# Seconds into the film to stop at. Empty renders to the end.
FILM_TO=
FILM_STILLS=0
FILM_BRAND=N-W-I-S
FILM_TAGLINE=Offset-well memory
FILM_LABEL=Oil India Limited
# ffmpeg binary. Empty uses the one bundled with imageio-ffmpeg.
FFMPEG=
# Viewport for recording/peek.ts.
W=1920
H=1080
DPR=1
