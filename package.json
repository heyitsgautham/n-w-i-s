{
  "name": "n-w-i-s",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "WELLS_PROD=1 node scripts/dev.mjs",
    "build": "pnpm --filter web build",
    "test": "pnpm test:ts && pnpm test:py",
    "test:ts": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:py": "uv run pytest -q",
    "lint": "pnpm --filter web lint && pnpm format:check && uv run ruff check . && uv run ruff format --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p packages/correlate && tsc -p packages/synth && tsc -p recording && pnpm --filter web exec next typegen && pnpm --filter web exec tsc --noEmit",
    "synth": "tsx packages/synth/src/cli.ts",
    "data": "pnpm synth && uv run python -m wells_ddr.render && uv run python -m wells_extract.run",
    "shots": "tsx recording/shots.ts",
    "film": "tsx recording/film.ts",
    "contact-sheet": "tsx recording/contact-sheet.ts",
    "voiceover": "tsx recording/voiceover.ts",
    "voice": "tsx recording/voice.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@vitest/coverage-v8": "4.1.12",
    "happy-dom": "^21.0.4",
    "playwright": "1.63.0",
    "prettier": "3.6.2",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "7.3.7",
    "vitest": "^4.1.12"
  }
}
