# Copy to apps/web/.env.local. Next.js inlines NEXT_PUBLIC_* values into the browser bundle at build time.

# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8121
# Maps JavaScript and Map Tiles APIs, for the flight to the field and the satellite map.
# Leave it empty and the arrival opens on the field and the map shows the drawn structure contours.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# The name, tagline and label on screen.
NEXT_PUBLIC_BRAND=N-W-I-S
NEXT_PUBLIC_BRAND_TAGLINE=Offset-well memory
NEXT_PUBLIC_BRAND_LABEL=Oil India Limited
